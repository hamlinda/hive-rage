[Unit]
Description=Hive Rage backend API service
After=network-online.target
Wants=network-online.target
After=hive-rage-ingestion.service
Requires=hive-rage-ingestion.service

[Service]
Type=simple
User=dlh
Group=dlh
WorkingDirectory=/opt/hive-rage
EnvironmentFile=-/etc/default/hive-rage
ExecStart=/usr/bin/python3 -m hive_rage run-backend
Restart=always
RestartSec=5

[Install]
WantedBy=hive-rage.target
